# Copy this file to .env.local for local development. Never commit the
# real values — set them in Vercel's dashboard instead (Project Settings
# -> Environment Variables), separately for Production/Preview/Development.

# Supabase project (admin panel's own data: news, gallery, event overrides,
# admin accounts, audit log). Find these in the Supabase dashboard under
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role secret key — server-only, never exposed to the browser.
# Bypasses Row Level Security: keep this out of client code and logs.
SUPABASE_SECRET_KEY=

# Pulse (the external events/ticketing backend this site reads from).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MEDIACRAFT_DOMAIN=

# Optional — only if lib/rate-limit.ts is upgraded from its current
# in-memory limiter to Upstash Redis (see docs/CHECKLIST-SEGURANCA.md, A8).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
